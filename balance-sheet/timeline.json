    },
    {
     "id": "v03_1",
     "t": 10.94,
     "dur": 1.535
    }
   ],
   "en": "On the left, assets: everything it owns.",
   "c0": 9.001,
   "c1": 13.075
  },
  {
   "id": "v04",
   "t0": 13.195,
   "t1": 15.194,
   "parts": [
    {
     "id": "v04_0",
     "t": 13.195,
     "dur": 1.999
    }
